{ "root": "../build/dist", "w": 390, "h": 844, "dpr": 2, "settle": 800,
  "probe": "(()=>{const r=e=>Math.round(e.getBoundingClientRect().top+scrollY);return {y:Math.round(scrollY),H:document.documentElement.scrollHeight,docW:document.documentElement.scrollWidth,stages:[...document.querySelectorAll('.stage')].map(r),spy:[...document.querySelectorAll('.spyhole')].map(e=>{const b=e.getBoundingClientRect();return [Math.round(b.left),Math.round(b.top),Math.round(b.width)]})}})()",
  "steps": [ { "wait": 600 }, { "still": "mobile" } ] }
