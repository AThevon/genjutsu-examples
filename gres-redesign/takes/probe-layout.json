{ "root": "../build/dist", "w": 1440, "h": 900, "settle": 800,
  "probe": "(()=>{const r=e=>{const b=e.getBoundingClientRect();return [Math.round(b.top+scrollY),Math.round(b.bottom+scrollY)]};return {H:document.documentElement.scrollHeight,stages:[...document.querySelectorAll('.stage')].map(r),seams:[...document.querySelectorAll('.seam')].map(e=>{const t=Math.round(e.getBoundingClientRect().top+scrollY);const s=getComputedStyle(e,'::before');return [e.className,t,s.top,s.height]}),glazeText:[...document.querySelectorAll('.stage')].map(s=>r(s.querySelector('.wrap > div')||s.querySelector('.wrap'))),spy:[...document.querySelectorAll('.spyhole')].map(r),footer:r(document.querySelector('.footer'))}})()",
  "steps": [ { "wait": 300 }, { "still": "probe" } ] }
